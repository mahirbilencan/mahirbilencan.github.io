---
import { Image } from "astro:assets";
import { site } from "../lib/site";
import profileImage from "../assets/images/profile.png";
---

<aside class="lg:sticky lg:top-20">
	<section class="rounded-sm border border-stone-200 bg-white p-6 ring-1 ring-stone-200">
 <div class="flex items-start gap-5 lg:flex-col">
 <div class="relative">
 <div class="overflow-hidden rounded-sm border border-stone-200 bg-stone-100 ">
 <Image
 src={profileImage}
 alt={`Portrait of ${site.name}`}
 loading="lazy"
 class="h-28 w-28 shrink-0 object-cover lg:h-auto lg:w-full lg:max-w-none"
 width={640}
 sizes="(max-width: 1024px) 112px, 288px"
 format="webp"
 quality={90}
 />
 </div>
 </div>

 <div class="min-w-0 space-y-3">
 <div>
 <p class="text-lg font-semibold leading-tight text-[#0f2c24]">{site.name}</p>
 <p class="mt-1 text-sm uppercase tracking-[0.16em] text-[#3f5a7a]">
 {site.role}
 </p>
 <p class="text-sm text-[#2c3a40]">{site.affiliation}</p>
 <p class="text-sm text-[#2c3a40]">{site.industryRole}, {site.industryAffiliation}</p>
 </div>

 <dl class="grid gap-3 text-sm text-[#2c3a40]">
 <div class="grid grid-cols-[5.5rem_1fr] gap-2">
 <dt class="text-[#3f5a7a]">Focus</dt>
 <dd class="min-w-0">Algebra, coding theory, secure communication</dd>
 </div>
 {site.location ? (
 <div class="grid grid-cols-[5.5rem_1fr] gap-2">
 <dt class="text-[#3f5a7a]">Location</dt>
 <dd class="min-w-0">{site.location}</dd>
 </div>
 ) : null}
 <div class="grid grid-cols-[5.5rem_1fr] gap-2">
 <dt class="text-[#3f5a7a]">Email</dt>
 <dd class="min-w-0 truncate">
 <a href={`mailto:${site.email}`}>{site.email}</a>
 </dd>
 </div>
 <div class="grid grid-cols-[5.5rem_1fr] gap-2">
 <dt class="text-[#3f5a7a]">CV</dt>
 <dd class="min-w-0">
 <a href="/CV.pdf">Download PDF</a>
 </dd>
 </div>
 </dl>

 <div class="flex flex-wrap gap-2 pt-1 text-sm">
 <a class="btn-primary" href="/CV.pdf">View CV</a>
 <a class="btn-secondary" href={`mailto:${site.email}`}>Email</a>
 </div>
 </div>
 </div>
	</section>
</aside>
