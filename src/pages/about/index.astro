---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../lib/site";
---

<SiteLayout title="About">
	<section class="space-y-6">
		<div class="border-b border-slate-200 pb-4">
			<h1>About</h1>
		</div>

		<div class="prose max-w-3xl">
			<p>
				I am a professor of mathematics at {site.affiliation}. My work spans algebraic groups and monoids,
				representation theory, algebraic geometry, and the mathematics of secure communication.
			</p>

			<h2>Research</h2>
			<p>
				Recent projects include geometric approaches to representation theory, classification problems for algebraic
				monoids, and algebraic constructions for error-correcting codes. For more details, see
				<a href="/research/">Research</a> and <a href="/publications/">Publications</a>.
			</p>

			<h2>Teaching and Mentorship</h2>
			<p>
				I teach undergraduate and graduate courses in algebra, geometry, and analysis, and I supervise graduate and
				undergraduate researchers. Teaching history is listed on the <a href="/teaching/">Teaching</a> page.
			</p>

			<h2>Contact</h2>
			<p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
			<p>Office: Gibson Hall, Room 319 — New Orleans, LA</p>
		</div>
	</section>
</SiteLayout>
