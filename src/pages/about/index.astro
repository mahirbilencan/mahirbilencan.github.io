---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../lib/site";
---

<SiteLayout title="About">
	<section class="space-y-6">
		<div class="border-b border-slate-200 pb-4">
			<h1>About</h1>
		</div>

		<div class="prose max-w-3xl">
			<p>
				I am a professor of mathematics at {site.affiliation} and a Senior Quantum Architecture Scientist at
				{site.industryAffiliation}. My work spans algebraic groups and monoids, representation theory,
				algebraic geometry, coding theory, secure communication, and quantum technologies.
			</p>

			<h2>Research</h2>
			<p>
				Recent projects include geometric approaches to representation theory, classification problems for algebraic
				monoids, and algebraic constructions for error-correcting codes. For more details, see
				<a href="/research/">Research</a> and <a href="/publications/">Publications</a>.
			</p>

			<h2>Professional Profile</h2>
			<p>
				This site emphasizes research output, industry-facing collaborations, and selected professional activities.
				Teaching and mentorship pages remain available as an academic archive rather than as the primary focus.
			</p>

			<h2>Contact</h2>
			<p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
			{site.location ? <p>Location: {site.location}</p> : null}
		</div>
	</section>
</SiteLayout>
