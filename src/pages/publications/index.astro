---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

let entries = [];
try {
	entries = await getCollection("publications");
} catch {
	entries = [];
}

entries = entries.filter((entry) => !entry.data.draft);
entries.sort((a, b) => {
	const left = a.data.order ?? Number.MAX_SAFE_INTEGER;
	const right = b.data.order ?? Number.MAX_SAFE_INTEGER;
	if (left !== right) return left - right;
	return b.data.date.valueOf() - a.data.date.valueOf();
});

const sections = [
	{
		id: "submitted",
		title: "Submitted and In Review",
		description: "Current manuscripts under review.",
		items: entries.filter((entry) => entry.data.status === "submitted"),
	},
	{
		id: "published",
		title: "Published Papers",
		description: "Journal and proceedings papers.",
		items: entries.filter((entry) => entry.data.status === "published" && entry.data.kind !== "book"),
	},
	{
		id: "preprints",
		title: "Announced Preprints",
		description: "Preprints with arXiv links when available.",
		items: entries.filter((entry) => entry.data.status === "preprint"),
	},
	{
		id: "books",
		title: "Books Edited",
		description: "Edited volumes and proceedings.",
		items: entries.filter((entry) => entry.data.kind === "book"),
	},
].filter((section) => section.items.length > 0);

function publicationLinks(entry: (typeof entries)[number]) {
	const links = entry.data.links ?? {};
	const list: Array<{ label: string; href: string }> = [];
	if (links.doi) list.push({ label: "DOI", href: links.doi });
	if (links.arxiv) list.push({ label: "arXiv", href: links.arxiv });
	if (links.pdf) list.push({ label: "PDF", href: links.pdf });
	if (links.project) list.push({ label: "Project", href: links.project });
	if (links.code) list.push({ label: "Code", href: links.code });
	if (links.website) list.push({ label: "URL", href: links.website });
	return list;
}

function isExternal(href: string) {
	return href.startsWith("http://") || href.startsWith("https://");
}

function bibtexKey(entry: (typeof entries)[number]) {
	const rawAuthor = entry.data.authors?.split(";")[0]?.trim() ?? "can";
	const surname = rawAuthor.split(/\s+/).slice(-1)[0]?.toLowerCase() ?? "can";
	const entryKey = entry.id ?? entry.slug ?? entry.data.title;
	const slugPart = entryKey.replace(/[^a-z0-9]+/gi, "").toLowerCase().slice(0, 12);
	return `${surname}${entry.data.date.getFullYear()}${slugPart}`;
}

function bibtexType(entry: (typeof entries)[number]) {
	if (entry.data.kind === "book") return "book";
	if (entry.data.kind === "conference") return "inproceedings";
	return "article";
}

function bibAuthor(entry: (typeof entries)[number]) {
	return (entry.data.authors ?? "Mahir Bilen Can").split(";").map((item) => item.trim()).join(" and ");
}

function bibDoi(entry: (typeof entries)[number]) {
	const raw = entry.data.links?.doi;
	if (!raw) return "";
	return raw.replace(/^https?:\/\/doi.org\//i, "");
}

function bibUrl(entry: (typeof entries)[number]) {
	return entry.data.links?.doi ?? entry.data.links?.arxiv ?? entry.data.links?.pdf ?? "";
}

function bibtex(entry: (typeof entries)[number]) {
	const type = bibtexType(entry);
	const lines = [
		`@${type}{${bibtexKey(entry)},`,
		`  author = {${bibAuthor(entry)}},`,
		`  title = {${entry.data.title}},`,
		`  year = {${entry.data.date.getFullYear()}},`,
	];

	if (entry.data.venue) {
		if (type === "article") lines.push(`  journal = {${entry.data.venue}},`);
		if (type === "inproceedings") lines.push(`  booktitle = {${entry.data.venue}},`);
		if (type === "book") lines.push(`  publisher = {${entry.data.venue}},`);
	}

	const doi = bibDoi(entry);
	if (doi) lines.push(`  doi = {${doi}},`);

	const url = bibUrl(entry);
	if (url) lines.push(`  url = {${url}},`);

	lines.push("}");
	return lines.join("\n");
}
---

<SiteLayout
	title="Publications"
	description="Publication list with citation actions, DOI links, and arXiv links."
>
	<div class="space-y-10">
		<section class="space-y-4 border-b border-slate-200 pb-6">
			<p class="section-title">Research Output</p>
			<h1 class="text-3xl leading-tight sm:text-5xl">Publications</h1>
			<p class="max-w-3xl text-[15px] leading-7 text-slate-700">
				Comprehensive publication record with quick actions for citations and external links.
			</p>
			<nav class="flex overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible sm:pb-0 gap-2" aria-label="Publication sections">
				{sections.map((section) => (
					<a class="pill" href={`#${section.id}`}>{section.title}</a>
				))}
			</nav>
		</section>

		{sections.map((section) => (
			<section id={section.id} class="scroll-mt-24 space-y-4">
				<div class="flex flex-wrap items-end justify-between gap-2 border-b border-slate-200 pb-3">
					<div>
						<h2 class="text-2xl leading-tight sm:text-3xl">{section.title}</h2>
						<p class="mt-1 text-sm text-slate-600">{section.description}</p>
					</div>
					<span class="text-sm text-slate-500">{section.items.length} items</span>
				</div>

				<ol class="space-y-5">
					{section.items.map((entry) => (
						<li class="border-b border-slate-200 pb-5">
							<p class="text-sm leading-7 text-slate-900">
								{entry.data.authors ? `${entry.data.authors}. ` : ""}
								<strong>{entry.data.title}.</strong>
								{entry.data.venue ? ` ${entry.data.venue}.` : ""}
							</p>

							<div class="mt-2 flex flex-wrap items-start gap-2 text-sm">
								<details class="inline-block">
									<summary class="pill cursor-pointer list-none">Cite</summary>
									<pre class="mt-2 overflow-x-auto border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700">
{bibtex(entry)}</pre>
								</details>

								{publicationLinks(entry).map((link) => (
									<a
										class="pill"
										href={link.href}
										target={isExternal(link.href) ? "_blank" : undefined}
										rel={isExternal(link.href) ? "noreferrer" : undefined}
									>
										{link.label}
									</a>
								))}
							</div>
						</li>
					))}
				</ol>
			</section>
		))}
	</div>
</SiteLayout>
