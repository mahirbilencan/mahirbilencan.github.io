---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

let entries = [];
try {
	entries = await getCollection("teaching");
} catch {
	entries = [];
}

entries = entries.filter((entry) => !entry.data.draft);
entries.sort((a, b) => String(b.data.term).localeCompare(String(a.data.term)));
---

<SiteLayout title="Teaching">
	<section class="space-y-6">
		<div class="border-b border-slate-200 pb-4">
			<h1>Teaching</h1>
			<p class="mt-3 max-w-3xl text-sm text-slate-700">
				Course history and instructional activity. Current course logistics and materials are shared through Canvas.
			</p>
		</div>

		{entries.length === 0 ? (
			<p class="text-sm text-slate-600">No teaching entries yet.</p>
		) : (
			<ul class="space-y-3">
				{entries.map((entry) => (
					<li class="border-b border-slate-200 pb-3">
						<p class="font-semibold text-slate-900">{entry.data.course}</p>
						<p class="text-sm text-slate-700">
							{entry.data.term}
							{entry.data.institution ? ` · ${entry.data.institution}` : ""}
							{entry.data.role ? ` · ${entry.data.role}` : ""}
						</p>
						{entry.data.links?.syllabus ? (
							<p class="mt-1 text-sm">
								<a href={entry.data.links.syllabus} target="_blank" rel="noreferrer">Syllabus</a>
							</p>
						) : null}
					</li>
				))}
			</ul>
		)}
	</section>
</SiteLayout>
