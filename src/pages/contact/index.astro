---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../lib/site";
---

<SiteLayout title="Contact" description={`How to reach ${site.name}.`}>
	<section class="space-y-6">
		<div class="border-b border-slate-200 pb-4">
			<h1>Contact</h1>
			<p class="max-w-2xl text-sm leading-7 text-slate-700">
				For research, industry, or collaboration inquiries, please include brief context and any relevant links.
				Teaching and advising records remain available as archive pages.
			</p>
		</div>

		<div class="max-w-2xl space-y-3 text-sm text-slate-700">
			<p>
				Email:
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</p>
			<p>
				ORCID:
				<a class="inline-flex items-center gap-2 no-underline" href={site.social.orcid} target="_blank" rel="noreferrer">
					<img src="/images/ai-orcid.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
					<span>0000-0002-0175-4897</span>
				</a>
			</p>
			<p>
				arXiv:
				<a class="inline-flex items-center gap-2 no-underline" href={site.social.arxiv} target="_blank" rel="noreferrer">
					<img src="/images/ai-arxiv.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
					<span>Author search results</span>
				</a>
			</p>
			<p>
				Google Scholar:
				<a class="inline-flex items-center gap-2 no-underline" href={site.social.googleScholar} target="_blank" rel="noreferrer">
					<img src="/images/ai-google-scholar.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
					<span>Citation profile</span>
				</a>
			</p>
		</div>
	</section>
</SiteLayout>
