---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { organizations } from "../../lib/site";

const editorialRoles = [
	{ title: "Semigroup Forum", role: "Editorial board service", link: "https://www.springer.com/journal/233" },
	{
		title: "Journal of Gökova Geometry-Topology",
		role: "Editorial board service",
		link: "https://www.jggt-online.com/",
	},
	{ title: "MathSciNet and zbMATH", role: "Regular reviewer", link: "https://mathscinet.ams.org/" },
] as const;

const organizedEvents = [
	{
		year: "2025",
		title: "Coding Theory and Cryptography (AMS Sectional Meeting)",
		location: "New Orleans, LA",
		note: "Co-organized with Henry Chimal Dzul and Emily McMillon.",
	},
	{
		year: "2024",
		title: "Generalized Numerical Semigroups (Thematic Session)",
		location: "Conference on Theoretical and Computational Algebra, Aveiro, Portugal",
		note: "Session organizer.",
	},
	{
		year: "2023",
		title: "Southern Regional Algebra Conference",
		location: "Tulane University",
		note: "Co-organized with Kalina Mincheva and Naufil Sakran.",
	},
] as const;

const recentActivities = [
	{
		year: "2025",
		detail:
			"Visited IIT Bombay for the conference on Combinatorics, Geometry, and Representation Theory at ICTS.",
	},
	{ year: "2025", detail: "Recipient of Tulane's Provost's Proof of Concept award." },
	{
		year: "2024",
		detail: "Fulbright U.S. Scholar to Portugal (host: Universidade Nova de Lisboa).",
	},
	{
		year: "2023",
		detail: "Research visits to IIT Bombay and the Okinawa Institute of Science and Technology.",
	},
] as const;
---

<SiteLayout title="Professional Activities" description="Editorial service, conference organization, and professional highlights.">
	<div class="space-y-10">
		<section class="space-y-4 border-b border-slate-200 pb-6">
			<p class="section-title">Professional Activities</p>
			<h1 class="text-3xl leading-tight sm:text-5xl">Service, Organization, and Community Work</h1>
			<p class="max-w-3xl text-[15px] leading-7 text-slate-700">
				Editorial service, conference organization, and selected professional highlights.
			</p>
			<div class="flex flex-wrap gap-2">
				<a class="pill" href="/publications/">Publications</a>
				<a class="pill" href="/CV.pdf">CV</a>
			</div>
		</section>

		<section class="space-y-4">
			<div class="border-b border-slate-200 pb-2">
				<h2 class="text-2xl sm:text-3xl">Industry and Ventures</h2>
			</div>
			<ul class="grid gap-3 md:grid-cols-2">
				{organizations.map((item) => (
					<li class="border border-slate-200">
						<a
							class="flex h-full gap-4 px-4 py-4 no-underline hover:bg-slate-50"
							href={item.href}
							target="_blank"
							rel="noreferrer"
						>
							<img
								src={item.logo.src}
								alt={`${item.name} logo`}
								class={`${item.logo.className} shrink-0 self-start object-contain`}
								loading="lazy"
								width={item.logo.width}
								height={item.logo.height}
							/>
							<span class="text-sm text-slate-700">
								<span class="block font-semibold text-slate-900">{item.name}</span>
								<span class="block">{item.role}</span>
								<span class="mt-2 block">{item.description}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="space-y-4">
			<div class="border-b border-slate-200 pb-2">
				<h2 class="text-2xl sm:text-3xl">Editorial Service</h2>
			</div>
			<ul class="space-y-3">
				{editorialRoles.map((item) => (
					<li class="border-b border-slate-200 pb-3">
						<p class="font-semibold text-slate-900">{item.title}</p>
						<p class="text-sm text-slate-600">{item.role}</p>
						<a class="mt-1 inline-flex text-sm no-underline hover:underline" href={item.link} target="_blank" rel="noreferrer">
							Visit
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="space-y-4">
			<div class="border-b border-slate-200 pb-2">
				<h2 class="text-2xl sm:text-3xl">Conference Organization</h2>
			</div>
			<ul class="space-y-3">
				{organizedEvents.map((event) => (
					<li class="border-b border-slate-200 pb-3 text-sm text-slate-700">
						<p class="font-semibold text-slate-900">
							{event.year} — {event.title}
						</p>
						<p>{event.location}</p>
						<p>{event.note}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="space-y-4">
			<div class="border-b border-slate-200 pb-2">
				<h2 class="text-2xl sm:text-3xl">Selected Highlights</h2>
			</div>
			<ul class="space-y-3">
				{recentActivities.map((item) => (
					<li class="border-b border-slate-200 pb-3 text-sm text-slate-700">
						<span class="font-semibold text-slate-900">{item.year}:</span> {item.detail}
					</li>
				))}
			</ul>
		</section>
	</div>
</SiteLayout>
