---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

let entries = [];
try {
	entries = await getCollection("talks");
} catch {
	entries = [];
}

entries = entries.filter((entry) => !entry.data.draft);
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteLayout title="Talks">
	<section class="space-y-6">
		<div class="border-b border-slate-200 pb-4">
			<h1>Talks</h1>
			<p class="mt-3 max-w-3xl text-sm text-slate-700">
				Talks, posters, and seminar presentations.
			</p>
		</div>

		{entries.length === 0 ? (
			<p class="text-sm text-slate-600">No talk entries yet.</p>
		) : (
			<ul class="space-y-3">
				{entries.map((entry) => (
					<li class="border-b border-slate-200 pb-3">
						<p class="font-semibold text-slate-900">{entry.data.title}</p>
						<p class="text-sm text-slate-700">
							{entry.data.event ? `${entry.data.event} · ` : ""}
							{entry.data.location ? `${entry.data.location} · ` : ""}
							{entry.data.date.toLocaleDateString(undefined, { year: "numeric", month: "short" })}
						</p>
					</li>
				))}
			</ul>
		)}
	</section>
</SiteLayout>
