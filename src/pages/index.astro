---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { organizations, site } from "../lib/site";
import { getCollection } from "astro:content";
import mahirImage from "../assets/images/Mahir.jpg";

const researchThemes = [
	{
		title: "Algebraic structures for modern computation",
		summary:
			"Algebraic groups, monoids, and representation-theoretic methods that clarify structure, symmetry, and computation.",
	},
	{
		title: "Coding theory and secure communication",
		summary:
			"Algebraic and geometric approaches to error-correcting codes, robust communication, and security-driven applications.",
	},
	{
		title: "Algebraic geometry and combinatorics",
		summary:
			"Geometric and combinatorial models for representation theory, Schubert varieties, monoids, and related moduli problems.",
	},
] as const;

const almaMaters = [
	{
		school: "University of Pennsylvania",
		degree: "PhD",
		year: "2006",
		href: "https://www.math.upenn.edu/",
		logo: {
			src: "/images/Penn-logo.png",
			width: 1760,
			height: 2000,
		},
	},
	{
		school: "METU (Turkey)",
		degree: "BSc",
		year: "2001",
		href: "https://math.metu.edu.tr/en/program-overview",
		logo: {
			src: "/images/metu.png",
			width: 640,
			height: 541,
		},
	},
] as const;

const recentHighlights = [
	{
		year: "2025",
		detail:
			"Visited IIT Bombay for the conference on Combinatorics, Geometry, and Representation Theory at ICTS.",
	},
	{ year: "2025", detail: "Received Tulane's Provost's Proof of Concept award." },
	{
		year: "2024",
		detail: "Fulbright U.S. Scholar to Portugal (host: Universidade Nova de Lisboa).",
	},
] as const;

let publications = [];
try {
	publications = await getCollection("publications");
} catch {
	publications = [];
}

const recentPublications = publications
	.filter((entry) => !entry.data.draft && entry.data.status !== "preprint" && entry.data.kind !== "book")
	.sort((a, b) => {
		const left = a.data.order ?? Number.MAX_SAFE_INTEGER;
		const right = b.data.order ?? Number.MAX_SAFE_INTEGER;
		if (left !== right) return left - right;
		return b.data.date.valueOf() - a.data.date.valueOf();
	})
	.slice(0, 6);

function publicationLinks(entry: (typeof recentPublications)[number]) {
	const links = entry.data.links ?? {};
	const list: Array<{ label: string; href: string }> = [];
	if (links.doi) list.push({ label: "DOI", href: links.doi });
	if (links.arxiv) list.push({ label: "arXiv", href: links.arxiv });
	if (links.project) list.push({ label: "Project", href: links.project });
	if (links.pdf) list.push({ label: "PDF", href: links.pdf });
	return list;
}

function isExternalLink(href: string) {
	return href.startsWith("http://") || href.startsWith("https://");
}
---

<SiteLayout title="Home" description={site.description}>
	<div class="space-y-12">
		<section class="grid gap-8 border-b border-slate-200 pb-10 lg:grid-cols-[15rem_minmax(0,1fr)]">
			<div class="space-y-4">
				<Image
					src={mahirImage}
					alt={`Portrait of ${site.name}`}
					class="mx-auto w-full max-w-[16rem] border border-slate-300 object-cover sm:max-w-[18rem] lg:mx-0 lg:max-w-none"
					loading="eager"
					width={900}
					sizes="(max-width: 640px) 16rem, (max-width: 1024px) 18rem, 240px"
					format="webp"
					quality={90}
				/>
				<div class="space-y-2 text-sm text-slate-700">
					<p class="font-semibold text-slate-900">{site.name}</p>
					<p>{site.role}</p>
					<p>{site.affiliation} ({site.academicStatus.toLowerCase()})</p>
					<p>{site.industryRole}</p>
					<p>{site.industryAffiliation}, starting {site.industryStartDate}</p>
					{site.location ? <p>{site.location}</p> : null}
					<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
				</div>
				<div class="flex flex-wrap gap-2">
					<a class="btn-primary" href="/CV.pdf">CV</a>
					<a class="btn-secondary" href={`mailto:${site.email}`}>Email</a>
					<a class="btn-secondary gap-2" href={site.social.orcid} target="_blank" rel="noreferrer">
						<img src="/images/ai-orcid.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
						<span>ORCID</span>
					</a>
					<a class="btn-secondary gap-2" href={site.social.arxiv} target="_blank" rel="noreferrer">
						<img src="/images/ai-arxiv.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
						<span>arXiv</span>
					</a>
					<a class="btn-secondary gap-2" href={site.social.googleScholar} target="_blank" rel="noreferrer">
						<img src="/images/ai-google-scholar.svg" alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" loading="lazy" />
						<span>Google Scholar</span>
					</a>
				</div>
				</div>

			<div class="space-y-6">
				<div>
					<p class="section-title">Mathematics · Coding Theory · Quantum Technologies</p>
					<h1 class="mt-2 text-3xl leading-tight sm:text-5xl">Mahir Bilen Can</h1>
					<p class="mt-4 max-w-3xl text-[16px] leading-8 text-slate-700">
						I am a mathematician specializing in algebraic geometry, coding theory, and quantum error correction. I am
						currently a Professor of Mathematics at Tulane University (on leave). Starting June 2026, I will be joining
						Xanadu Quantum Technologies full-time to focus on logical prototyping and code construction.
					</p>
				</div>

				<dl class="grid gap-3 border-y border-slate-200 py-4 text-sm text-slate-700">
					<div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)]">
						<dt class="font-semibold text-slate-900">Academic Role</dt>
						<dd>{site.role}, {site.affiliation} ({site.academicStatus.toLowerCase()})</dd>
				</div>
					<div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)]">
						<dt class="font-semibold text-slate-900">Industry Role</dt>
						<dd>{site.industryRole}, {site.industryAffiliation}, starting {site.industryStartDate}</dd>
					</div>
					<div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)]">
						<dt class="font-semibold text-slate-900">Research</dt>
						<dd>Algebraic structures, coding theory, secure communication, quantum technologies</dd>
					</div>
				</dl>

				<div>
					<p class="mb-2 text-sm font-semibold text-slate-900">Industry and Ventures</p>
					<ul class="grid gap-2 sm:grid-cols-2">
						{organizations.map((item) => (
							<li>
								<a
									class="flex h-full gap-3 border border-slate-200 px-3 py-3 no-underline hover:bg-slate-50"
									href={item.href}
									target="_blank"
									rel="noreferrer"
								>
									<img
										src={item.logo.src}
										alt={`${item.name} logo`}
										class={`${item.logo.className} shrink-0 self-start object-contain`}
										loading="lazy"
										width={item.logo.width}
										height={item.logo.height}
									/>
									<span class="text-sm text-slate-700">
										<span class="block font-semibold text-slate-900">{item.name}</span>
										<span class="block">{item.role}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div>
					<p class="mb-2 text-sm font-semibold text-slate-900">Education</p>
					<ul class="grid gap-2 sm:grid-cols-2">
						{almaMaters.map((item) => (
							<li>
								<a
									class="flex items-center gap-3 border border-slate-200 bg-white px-3 py-2 no-underline hover:bg-slate-50"
									href={item.href}
									target="_blank"
									rel="noreferrer"
								>
									<img
										src={item.logo.src}
										alt={`${item.school} logo`}
										class="h-9 w-9 object-contain"
										loading="lazy"
										width={item.logo.width}
										height={item.logo.height}
									/>
									<span class="text-sm text-slate-700">
										<span class="block font-semibold text-slate-900">{item.school}</span>
										<span>{item.degree} ({item.year})</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<div class="flex items-end justify-between gap-3 border-b border-slate-200 pb-2">
				<div>
					<p class="section-title">Research</p>
					<h2 class="text-2xl sm:text-3xl">Themes</h2>
				</div>
				<a class="pill" href="/research/">Research page</a>
			</div>
			<ul class="space-y-3">
				{researchThemes.map((theme) => (
					<li class="border-b border-slate-200 pb-3">
						<h3 class="text-lg">{theme.title}</h3>
						<p class="mt-1 text-sm text-slate-700">{theme.summary}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="space-y-4">
			<div class="flex items-end justify-between gap-3 border-b border-slate-200 pb-2">
				<div>
					<p class="section-title">Publications</p>
					<h2 class="text-2xl sm:text-3xl">Recent Papers</h2>
				</div>
				<a class="pill" href="/publications/">Full list</a>
			</div>

			<ol class="space-y-4">
				{recentPublications.map((entry) => (
					<li class="border-b border-slate-200 pb-4">
						<p class="text-sm leading-7 text-slate-900">
							{entry.data.authors ? `${entry.data.authors}. ` : ""}
							<strong>{entry.data.title}.</strong>
							{entry.data.venue ? ` ${entry.data.venue}.` : ""}
						</p>
						<div class="mt-2 flex flex-wrap gap-2">
							{publicationLinks(entry).map((link) => (
								<a
									class="pill"
									href={link.href}
									target={isExternalLink(link.href) ? "_blank" : undefined}
									rel={isExternalLink(link.href) ? "noreferrer" : undefined}
								>
									{link.label}
								</a>
							))}
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="grid gap-6 border-t border-slate-200 pt-8 lg:grid-cols-[1.3fr_0.7fr]">
			<div class="space-y-3">
				<div class="border-b border-slate-200 pb-3">
					<p class="section-title">Professional Record</p>
					<h2 class="text-2xl sm:text-3xl">Selected Highlights</h2>
				</div>
				<ul class="space-y-2">
					{recentHighlights.map((item) => (
						<li class="border-b border-slate-200 pb-2 text-sm text-slate-700">
							<span class="font-semibold text-slate-900">{item.year}:</span> {item.detail}
						</li>
					))}
				</ul>
				<a class="pill" href="/work/">Industry & service</a>
			</div>

			<div class="space-y-4 border border-slate-200 bg-slate-50 p-5">
				<div>
					<p class="section-title">Academic Archive</p>
					<h2 class="mt-2 text-2xl">Teaching & Mentorship</h2>
					<p class="mt-2 text-sm text-slate-700">
						Maintained for completeness, but intentionally secondary to research, industry, and publication information.
					</p>
				</div>

				<div class="grid gap-3 text-sm text-slate-700">
					<a class="surface no-underline hover:bg-white" href="/teaching/">
						<span class="block font-semibold text-slate-950">Teaching Archive</span>
						<span>Course history</span>
					</a>
					<a class="surface no-underline hover:bg-white" href="/students/">
						<span class="block font-semibold text-slate-950">Student Mentorship</span>
						<span>Graduate mentorship archive</span>
					</a>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>
