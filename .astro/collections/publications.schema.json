{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "default": "journal",
      "type": "string",
      "enum": [
        "submitted",
        "journal",
        "conference",
        "preprint",
        "book"
      ]
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "authors": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "status": {
      "default": "published",
      "type": "string",
      "enum": [
        "submitted",
        "published",
        "preprint"
      ]
    },
    "abstract": {
      "type": "string"
    },
    "selected": {
      "default": false,
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": "string",
          "minLength": 1
        },
        "arxiv": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}