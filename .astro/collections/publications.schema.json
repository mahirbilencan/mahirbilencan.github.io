{
  "$ref": "#/definitions/publications",
  "definitions": {
    "publications": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "boolean",
          "default": false
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "submitted",
            "journal",
            "conference",
            "preprint",
            "book"
          ],
          "default": "journal"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "authors": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "published",
            "preprint"
          ],
          "default": "published"
        },
        "abstract": {
          "type": "string"
        },
        "selected": {
          "type": "boolean",
          "default": false
        },
        "links": {
          "type": "object",
          "properties": {
            "pdf": {
              "type": "string",
              "minLength": 1
            },
            "arxiv": {
              "$ref": "#/definitions/publications/properties/links/properties/pdf"
            },
            "doi": {
              "$ref": "#/definitions/publications/properties/links/properties/pdf"
            },
            "code": {
              "$ref": "#/definitions/publications/properties/links/properties/pdf"
            },
            "project": {
              "$ref": "#/definitions/publications/properties/links/properties/pdf"
            },
            "website": {
              "$ref": "#/definitions/publications/properties/links/properties/pdf"
            }
          },
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "date"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}