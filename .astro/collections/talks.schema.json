{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "talk",
        "poster",
        "tutorial",
        "seminar"
      ]
    },
    "selected": {
      "default": false,
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "properties": {
        "slides": {
          "type": "string",
          "format": "uri"
        },
        "video": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}