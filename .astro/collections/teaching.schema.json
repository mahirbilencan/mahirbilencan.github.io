{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "course": {
      "type": "string"
    },
    "term": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "properties": {
        "syllabus": {
          "type": "string",
          "format": "uri"
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "course",
    "term"
  ]
}